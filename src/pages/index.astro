---
const languageModules = import.meta.glob("../i18n/*.ts", {
  eager: true,
  import: "default",
}) as Record<string, { lang: string }>;

const supportedLanguages = Object.values(languageModules).map(
  (module) => module.lang
);
---
<noscript>
  <nav aria-label="Language selection">
    <a href="/ca/">Català</a>
    <a href="/es/">Español</a>
    <a href="/en/">English</a>
  </nav>
</noscript>

<script define:vars={{ supportedLanguages }}>
  const storedLanguage = localStorage.getItem("language");

  let language;

  if (storedLanguage && supportedLanguages.includes(storedLanguage)) {
    language = storedLanguage;
  } else {
    const browserLanguages = navigator.languages ?? [navigator.language];

    language = browserLanguages
      .map((lang) => lang.split("-")[0])
      .find((lang) => supportedLanguages.includes(lang));
  }

  language ??= "ca";

  window.location.replace(`/${language}/`);
</script>