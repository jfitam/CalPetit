---
import Base from "../layouts/Base.astro";
import getContent from "../../utils/getcontent.ts"
const SITE = getContent(Astro.currentLocale)

export function getStaticPath() {
  return [
    {params: { lang: "ca" } },
    {params: { lang: "es" } },
    {params: { lang: "en" } },
  ]
}
---

<Base
  title={`${SITE.ui.notFoundTitle} — ${SITE.name}`}
  description={SITE.ui.notFoundText}
  noindex
>
  <div class="container page-content">
    <h1>{SITE.ui.notFoundTitle}</h1>
    <p>{SITE.ui.notFoundText}</p>
    <p><a class="button" href="/">{SITE.ui.notFoundCta}</a></p>
  </div>
</Base>
